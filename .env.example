# Rendered into app.yml by scripts/30-install-discourse.sh. Copy to .env, which
# is gitignored, as is the rendered app.yml: both hold the SMTP password.

# Must resolve to this host, on plain DNS, before installing.
DISCOURSE_HOSTNAME=forum.qupa-cafe.com

# Registering with this address grants admin; the certificate request uses it.
DISCOURSE_DEVELOPER_EMAILS=you@example.com

# Optional. The install refuses to run if DISCOURSE_HOSTNAME resolves elsewhere.
EXPECTED_IP=

# The data volume's mount point: database, uploads, backups.
DISCOURSE_DATA_DIR=/mnt/qupa-cafe

# Nothing validates these until a mail is sent.
DISCOURSE_SMTP_ADDRESS=smtp-relay.brevo.com
DISCOURSE_SMTP_USER_NAME=
DISCOURSE_SMTP_PASSWORD=

# Optional: the Slack bridge, providers/slack/README.md.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
