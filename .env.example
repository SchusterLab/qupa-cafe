# Values that scripts/30-install-discourse.sh renders into app.yml.
#
# Copy to .env and fill in. .env is gitignored; the rendered app.yml is too.
# Both contain the SMTP password in plaintext.

# The public hostname of the forum. Must already resolve to this host, on plain
# DNS rather than behind a proxying CDN, before you install -- the Let's Encrypt
# HTTP-01 challenge happens during the bootstrap.
DISCOURSE_HOSTNAME=forum.qupa-cafe.com

# Optional. A platform-assigned automatic hostname belongs here rather than as
# the primary. Comma-separated. Leave empty if there is none.
DISCOURSE_HOSTNAME_ALIASES=

# Registering with this address on the new site grants admin automatically.
# It is also the address the certificate request uses.
DISCOURSE_DEVELOPER_EMAILS=you@example.com

# Optional. If set, 30-install-discourse.sh checks the A record against it and
# refuses to install on a mismatch.
EXPECTED_IP=

# --------------------------------------------------------------------- SMTP
#
# Nothing validates these. A wrong value bootstraps cleanly and fails at the
# first password reset. Send a real test message after installing.
DISCOURSE_SMTP_ADDRESS=smtp-relay.brevo.com
DISCOURSE_SMTP_USER_NAME=
DISCOURSE_SMTP_PASSWORD=
