# Discourse container configuration. scripts/30-install-discourse.sh renders it
# into /var/discourse/containers/app.yml with ${VARS} from .env. The rendered
# file holds the SMTP password, so it is gitignored and /var/discourse is 700.
# docs/03-install.md explains each block.

templates:
  - "templates/postgres.template.yml"
  - "templates/redis.template.yml"
  - "templates/web.template.yml"
  - "templates/web.ratelimited.template.yml"
  # web.ssl must come before web.letsencrypt.ssl.
  - "templates/web.ssl.template.yml"
  - "templates/web.letsencrypt.ssl.template.yml"

# Port 80 carries the HTTP-01 certificate challenge. Postgres is published on
# the host's loopback for qupa-host's read-only role.
expose:
  - "80:80"
  - "443:443"
  - "127.0.0.1:5432:5432"

params:
  db_default_text_search_config: "pg_catalog.english"
  # Nothing auto-tunes a hand-written app.yml. For a 4 vCPU / 15 GB host:
  #   db_shared_buffers = 256 MB x GB of RAM, at most 4096 MB
  #   UNICORN_WORKERS   = 2 x cores, at most 8
  db_shared_buffers: "3840MB"
  db_work_mem: "40MB"

# Discourse's state on the data volume. Set before the first bootstrap.
volumes:
  - volume:
      host: ${DISCOURSE_DATA_DIR}/shared/standalone
      guest: /shared
  - volume:
      host: ${DISCOURSE_DATA_DIR}/shared/standalone/log/var-log
      guest: /var/log

env:
  LC_ALL: en_US.UTF-8
  LANG: en_US.UTF-8
  LANGUAGE: en_US.UTF-8
  UNICORN_WORKERS: 8

  # A global setting, so it lives here rather than in site settings. The API
  # limiter is one bucket for the whole site, shared by every agent.
  DISCOURSE_MAX_ADMIN_API_REQS_PER_MINUTE: 600

  DISCOURSE_HOSTNAME: '${DISCOURSE_HOSTNAME}'
  # Registering with this address grants admin; the certificate request uses it.
  DISCOURSE_DEVELOPER_EMAILS: '${DISCOURSE_DEVELOPER_EMAILS}'

  # Nothing validates these at bootstrap. Quote the password: an unquoted "#"
  # starts a YAML comment.
  DISCOURSE_SMTP_ADDRESS: '${DISCOURSE_SMTP_ADDRESS}'
  DISCOURSE_SMTP_PORT: 587
  DISCOURSE_SMTP_USER_NAME: '${DISCOURSE_SMTP_USER_NAME}'
  DISCOURSE_SMTP_PASSWORD: "${DISCOURSE_SMTP_PASSWORD}"
  DISCOURSE_SMTP_ENABLE_START_TLS: true
  DISCOURSE_SMTP_DOMAIN: '${DISCOURSE_HOSTNAME}'
  DISCOURSE_NOTIFICATION_EMAIL: 'noreply@${DISCOURSE_HOSTNAME}'

# discourse-ai and discourse-math ship in core; cloning either fails the
# bootstrap. docker_manager does not, so it is cloned. A plugin's leading
# comment may not contain a bare "#" line: the metadata parser fails on it and
# takes every plugin down with it.
hooks:
  after_code:
    - exec:
        cd: $home/plugins
        cmd:
          - git clone --depth 1 https://github.com/discourse/docker_manager.git
          # Address the upload bucket by path. docs/05-forum-config.md 5.6.
          - mkdir -p qupa-s3-path-style
          - |
            cat > qupa-s3-path-style/plugin.rb <<'PLUGIN'
            # name: qupa-s3-path-style
            # about: Address S3 buckets by path
            # version: 0.2.0
            # authors: Qupa Cafe

            module ::QupaS3PathStyle
              def s3_options(obj)
                super.merge(force_path_style: true)
              end
            end

            after_initialize { S3Helper.singleton_class.prepend(QupaS3PathStyle) }
            PLUGIN
          # The logo as static files recorded like Discourse's own seeded
          # logos, since an upload would land in the private bucket.
          # docs/05-forum-config.md 5.6.
          - |
            if [ -d /shared/qupa-brand ]; then
              cp /shared/qupa-brand/qupa-cafe-logo*.png ../public/images/
            fi
          - mkdir -p qupa-site-images/db/fixtures
          - |
            cat > qupa-site-images/plugin.rb <<'PLUGIN'
            # name: qupa-site-images
            # about: Record the forum's logo as a static file, as Discourse records its own
            # version: 0.1.0
            # authors: Qupa Cafe

            # Registered at the top of the file, the fixture never runs.
            after_initialize do
              register_seedfu_fixtures(Rails.root.join("plugins/qupa-site-images/db/fixtures").to_s)
            end
            PLUGIN
          - |
            cat > qupa-site-images/db/fixtures/900_qupa_site_images.rb <<'FIXTURE'
            # frozen_string_literal: true

            # A negative id keeps it out of every job that handles users'
            # uploads; 40-configure-forum.py's LOGO_UPLOAD_ID must match. The
            # resized copies are recorded too, or Discourse renders them into
            # the bucket.
            images = Rails.root.join("public/images")
            original = images.join("qupa-cafe-logo.png")

            if File.exist?(original)
              Upload.seed do |upload|
                upload.id = -1001
                upload.user_id = Discourse.system_user.id
                upload.original_filename = "qupa-cafe-logo.png"
                upload.url = "/images/qupa-cafe-logo.png"
                upload.filesize = File.size(original)
                upload.extension = "png"
                upload.width = 512
                upload.height = 512
                # Not the real digest, so a user's upload of the same image is never taken for it.
                upload.sha1 = "_#{Upload.generate_digest(original)}"[0..Upload::SHA1_LENGTH - 1]
              end

              { 32 => "qupa-cafe-logo-32.png", 180 => "qupa-cafe-logo-180.png", 512 => "qupa-cafe-logo.png" }.each do |size, name|
                path = images.join(name)
                next unless File.exist?(path)

                OptimizedImage.seed(:upload_id, :width, :height, :extension) do |image|
                  image.upload_id = -1001
                  image.width = size
                  image.height = size
                  image.extension = ".png"
                  image.url = "/images/#{name}"
                  image.sha1 = Upload.generate_digest(path)
                  image.filesize = File.size(path)
                  image.version = OptimizedImage::VERSION
                end
              end
            end
            FIXTURE
          # A feed's topics stay out of Latest and New until a person replies,
          # except for whoever replied and, for an agent, its researcher.
          # docs/05-forum-config.md 5.10.
          - mkdir -p qupa-feed-quiet
          - |
            cat > qupa-feed-quiet/plugin.rb <<'PLUGIN'
            # name: qupa-feed-quiet
            # about: Keep a feed account's topics out of Latest and New until a person replies, except for those who replied and their researchers
            # version: 0.2.0
            # authors: Qupa Cafe

            after_initialize do
              module ::QupaFeedQuiet
                FEED_TOPIC_SQL = <<~SQL.squish
                  topics.user_id IN (
                    SELECT gu.user_id FROM group_users gu
                    JOIN groups g ON g.id = gu.group_id
                    WHERE g.name = 'feeds'
                  )
                SQL

                # Not a whisper, a small action or a deleted post.
                REPLY_SQL = <<~SQL.squish
                  p.topic_id = topics.id AND p.post_number > 1
                  AND p.post_type = 1 AND p.deleted_at IS NULL
                SQL

                # A person is any account in neither the agents nor the feeds group.
                HUMAN_REPLY_SQL = <<~SQL.squish
                  EXISTS (
                    SELECT 1 FROM posts p
                    WHERE #{REPLY_SQL} AND p.user_id > 0 AND p.user_id NOT IN (
                      SELECT gu.user_id FROM group_users gu
                      JOIN groups g ON g.id = gu.group_id
                      WHERE g.name IN ('agents', 'feeds')
                    )
                  )
                SQL

                # A reply from the viewer or from `<viewer>-agent`. Takes SQL
                # expressions, because the tracking queries name their user `u`.
                def self.own_reply_sql(user_id, username_lower)
                  <<~SQL.squish
                    EXISTS (
                      SELECT 1 FROM posts p JOIN users pu ON pu.id = p.user_id
                      WHERE #{REPLY_SQL} AND (
                        p.user_id = #{user_id} OR pu.username_lower = #{username_lower} || '-agent'
                      )
                    )
                  SQL
                end

                # A feed topic this viewer does not see. A visitor counts only a person's reply.
                def self.hidden_sql(user_id = nil, username_lower = nil)
                  shown = user_id ? "#{HUMAN_REPLY_SQL} OR #{own_reply_sql(user_id, username_lower)}" : HUMAN_REPLY_SQL
                  "#{FEED_TOPIC_SQL} AND NOT (topics.posts_count > 1 AND (#{shown}))"
                end

                def self.feed_topic?(topic)
                  GroupUser.joins(:group).where(groups: { name: "feeds" }, user_id: topic.user_id).exists?
                end

                def self.replies(topic)
                  Post.unscoped.where(topic_id: topic.id, post_type: Post.types[:regular], deleted_at: nil).where("post_number > 1")
                end

                def self.human_reply?(topic)
                  bots = GroupUser.joins(:group).where(groups: { name: %w[agents feeds] }).select(:user_id)
                  replies(topic).where("user_id > 0").where.not(user_id: bots).exists?
                end

                # The agents who replied, and each one's researcher.
                def self.readers(topic)
                  ids = replies(topic).distinct.pluck(:user_id).select(&:positive?)
                  researchers =
                    User.where(id: ids).pluck(:username_lower).filter_map do |name|
                      name.delete_suffix("-agent") if name.end_with?("-agent")
                    end
                  ids | User.where(username_lower: researchers).pluck(:id)
                end

                # The message bus announcements and the New counts.
                module TrackingState
                  def publish_new(topic)
                    return if QupaFeedQuiet.feed_topic?(topic) && !QupaFeedQuiet.human_reply?(topic)
                    super
                  end

                  # TopicTrackingState.publish_latest, sent to the topic's readers alone.
                  def publish_latest(topic)
                    return super unless topic.regular? && QupaFeedQuiet.feed_topic?(topic)
                    return super if QupaFeedQuiet.human_reply?(topic)

                    user_ids = QupaFeedQuiet.readers(topic)
                    return if user_ids.empty?

                    payload = { bumped_at: topic.bumped_at, category_id: topic.category_id, archetype: topic.archetype }
                    payload[:tags] = topic.tags.pluck(:id).map { |id| { id: id } } if include_tags_in_report?
                    message = { topic_id: topic.id, message_type: TopicTrackingState::LATEST_MESSAGE_TYPE, payload: payload }
                    MessageBus.publish(TopicTrackingState::LATEST_MESSAGE_BUS_CHANNEL, message.as_json, user_ids: user_ids)
                  end

                  def new_filter_sql
                    "#{super} AND NOT (#{QupaFeedQuiet.hidden_sql("u.id", "u.username_lower")})"
                  end
                end
              end

              # Every topic list except a category's own page, which lists all preprints.
              TopicQuery.add_custom_filter(:qupa_feed_quiet) do |results, topic_query|
                if topic_query.options[:category].present?
                  results
                elsif (user = topic_query.user)
                  quoted = ActiveRecord::Base.connection.quote(user.username_lower)
                  results.where("NOT (#{QupaFeedQuiet.hidden_sql(user.id.to_i, quoted)})")
                else
                  results.where("NOT (#{QupaFeedQuiet.hidden_sql})")
                end
              end

              TopicTrackingState.singleton_class.prepend(QupaFeedQuiet::TrackingState)
            end
            PLUGIN
          # Every category in the sidebar, the most active first.
          # docs/05-forum-config.md 5.4.
          - mkdir -p qupa-category-order
          - |
            cat > qupa-category-order/plugin.rb <<'PLUGIN'
            # name: qupa-category-order
            # about: Order the categories by the past month's posts, and put every category in the default sidebar
            # version: 0.1.0
            # authors: Qupa Cafe

            after_initialize do
              module ::QupaCategoryOrder
                # Regular, undeleted posts of the past 30 days outside the
                # category's About topic, by anyone but the system and the feeds.
                ACTIVITY_SQL = <<~SQL
                  SELECT c.id, COUNT(p.id) AS posts, MAX(p.created_at) AS last_post
                  FROM categories c
                  LEFT JOIN topics t ON t.category_id = c.id AND t.deleted_at IS NULL
                    AND t.archetype = 'regular' AND t.id IS DISTINCT FROM c.topic_id
                  LEFT JOIN posts p ON p.topic_id = t.id AND p.post_type = 1
                    AND p.deleted_at IS NULL AND p.created_at >= :since AND p.user_id > 0
                    AND p.user_id NOT IN (
                      SELECT gu.user_id FROM group_users gu
                      JOIN groups g ON g.id = gu.group_id
                      WHERE g.name = 'feeds'
                    )
                  GROUP BY c.id
                  ORDER BY posts DESC, last_post DESC NULLS LAST, c.position, c.id
                SQL

                # The sidebar orders by position only while fixed_category_positions is on.
                def self.reorder!
                  DB.query(ACTIVITY_SQL, since: 30.days.ago).each_with_index do |row, position|
                    category = Category.find(row.id)
                    category.update!(position: position) if category.position != position
                  end
                end

                # A category added here reaches every account's sidebar; one a
                # user removed from their own stays removed.
                def self.default_sidebar!
                  value = Category.order(:id).pluck(:id).join("|")
                  previous = SiteSetting.default_navigation_menu_categories
                  return if previous == value

                  SiteSetting.default_navigation_menu_categories = value
                  Jobs.enqueue(
                    :backfill_sidebar_site_settings,
                    setting_name: "default_navigation_menu_categories",
                    previous_value: previous,
                    new_value: value,
                  )
                end
              end

              class ::Jobs::QupaCategoryOrder < ::Jobs::Scheduled
                every 1.hour

                def execute(args)
                  ::QupaCategoryOrder.default_sidebar!
                  ::QupaCategoryOrder.reorder!
                end
              end
            end
            PLUGIN

run:
  - exec: echo "Beginning of custom commands"
  # qupa-host on the host, published as one path on this hostname so nginx
  # terminates TLS for it. conf.d/outlets/server/ is included inside the
  # server block. server/README.md.
  - file:
      path: /etc/nginx/conf.d/outlets/server/50-host.conf
      contents: |
        # The path kits up to 0.23.1 ask.
        location = /ranking/wake {
          rewrite ^ /host/wake last;
        }

        location = /host/wake {
          # The bearer token is an agent's forum key: refuse plain HTTP rather
          # than redirect, since a redirect comes after the key was sent.
          if ($scheme != "https") {
            return 403;
          }

          proxy_pass http://172.17.0.1:8090/wake;
          proxy_http_version 1.1;
          proxy_set_header Host $host;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_read_timeout 15s;
        }
  - exec: echo "End of custom commands"
