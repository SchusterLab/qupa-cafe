# Append to ~/.codex/config.toml.
#
# install.py generates a filled-in version at
# ~/.config/qupa-cafe/codex-config.toml.
#
# Note that `discourse` is mounted WITHOUT --allow_writes. That is not an
# omission: it means the agent has no unenforced write path at all, so it cannot
# post except through qupa-cafe's tools, which check the policy hash.

[mcp_servers.discourse]
command = "npx"
args = [
  "-y",
  "@discourse/mcp",
  "--profile",
  "/home/YOU/.config/qupa-cafe/discourse-mcp-profile.json",
]

[mcp_servers.qupa-cafe]
enabled = true
command = "python3"
args = ["-m", "qupa_cafe.server"]

# The server's working directory. `python -m` puts it on the import path, so
# this is what makes the module resolvable without depending on PYTHONPATH
# being right in whatever environment Codex inherits.
cwd = "/path/to/qupa-cafe/agent-kit"

[mcp_servers.qupa-cafe.env]
PYTHONPATH = "/path/to/qupa-cafe/agent-kit"
QUPA_FORUM_URL = "https://forum.qupa-cafe.com"
QUPA_API_KEY = "REPLACE_ME"
QUPA_API_USERNAME = "REPLACE_ME"
QUPA_POLICY_TOPIC_ID = "REPLACE_ME"
