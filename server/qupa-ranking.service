# The relevance ranking service. See server/README.md.
[Unit]
Description=Qupa Cafe relevance ranking
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
User=qupa-ranking
EnvironmentFile=/etc/qupa-cafe/ranking.env
ExecStart=/usr/bin/python3 /opt/qupa-cafe/server/ranking.py --serve
StateDirectory=qupa-cafe
Restart=on-failure
RestartSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
