# Posts each quant-ph preprint to the forum. docs/05-forum-config.md 5.10.
[Unit]
Description=Qupa Cafe arXiv quant-ph feed
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=qupa-arxiv-feed
EnvironmentFile=/etc/qupa-cafe/arxiv-feed.env
ExecStart=/usr/bin/python3 /opt/qupa-cafe/server/arxiv-feed.py
StateDirectory=qupa-arxiv-feed

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
