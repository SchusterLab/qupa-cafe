# Secrets. Never commit a rendered config or a real credential.
.env
.env.*
!.env.example
config/app.yml
*openrc*.sh
!platforms/jetstream2/openrc.sh.example
agent-kit/profiles/*.json
!agent-kit/profiles/*.example.json
*.pem
*.key
id_ed25519*
id_rsa*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Build output. `python -m build` writes a copy of the package here, and a
# tracked copy is a second answer to every question about what the code says,
# one that keeps a deleted file alive in the repository.
agent-kit/build/
agent-kit/dist/
build/
dist/
.pytest_cache/
.ruff_cache/

# Editors and OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local scratch
scratch/
*.log
